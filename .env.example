# Placeholders only. Never commit a real value.
#
# You do NOT need this file to start work:
#   make test      no keys
#   make capture   no keys   <- do this first, while streams are live
#   make replay    no keys   (reads the committed model-response cache)
#   make baseline  no keys
#   make eval      no keys
#
# Keys are needed for exactly two things: `make enrich` (turning raw capture into a fixture)
# and `TS_LLM_MODE=record` (populating the cache). Both are one-time, and neither is on the
# path a judge runs.

TS_LLM_MODE=replay                       # replay | record | live
TS_TEXT_MODEL=deepseek-v4-flash          # deepseek-chat was RETIRED 2026-07-24
TS_VISION_MODEL=deepseek-v4-flash-vision-exp   # V4-Flash is text-only; vision is a separate model

# needed by: make enrich (speech)
DEEPGRAM_API_KEY=

# needed by: make enrich (frame captions) and TS_LLM_MODE=record
DEEPSEEK_API_KEY=

# optional: escalation for ambiguous cases. Only keep it if the eval shows it earns its cost.
TS_ESCALATION_MODEL=deepseek-v4-pro
