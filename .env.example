# Placeholders only. Never commit a real value.
#
# You do NOT need this file to start work:
#   make test      no keys
#   make capture   no keys   <- do this first, while streams are live
#   make replay    no keys   (reads the committed model-response cache)
#   make baseline  no keys
#   make eval      no keys
#   make demo      no keys   (including Live -> Tier 0 chat, which calls no model)
#
# Keys are needed for exactly two things: `make enrich` (turning raw capture into a fixture)
# and `TS_LLM_MODE=record` (populating the cache). Both are one-time, and neither is on the
# path a judge runs.
#
# ---------------------------------------------------------------------------------------
# THE MODEL NAMES ARE COMMENTED OUT ON PURPOSE. DO NOT UNCOMMENT THEM TO RUN THE EVAL.
#
# The model name is part of the cache key. Every recorded response was produced by
# `gpt-4.1-nano` (text) and `gpt-4.1-mini` (vision), and the code defaults to exactly those
# when the variables are unset. Setting them to anything else turns every cached entry into a
# miss and `make eval` stops reproducing — which is the whole submission.
#
# This file used to set `TS_TEXT_MODEL=deepseek-v4-flash`, and copying it to `.env` was enough
# to break `make eval` completely. Verified on 2026-08-30: every call missed the cache.
# Leave them unset unless you are deliberately re-recording.
# ---------------------------------------------------------------------------------------

TS_LLM_MODE=replay                       # replay | record | live. replay needs no key at all.

# TS_TEXT_MODEL=gpt-4.1-nano             # the recorded default. Leave unset for replay.
# TS_VISION_MODEL=gpt-4.1-mini           # the recorded default. Leave unset for replay.

# ---- keys, needed only to record ----

# The text and vision provider. The code reads TS_LLM_API_KEY first, then DEEPSEEK_API_KEY,
# and the base URL decides which service those keys are sent to. The recordings in this
# repository were made against OpenAI, so the base URL must say so — the built-in default is
# DeepSeek's, and pointing an OpenAI key at it returns 401 `invalid_api_key`.
TS_LLM_BASE_URL=https://api.openai.com/v1
TS_LLM_API_KEY=

# Fallback name for the same key, kept because older scripts read it.
DEEPSEEK_API_KEY=

# needed by: make enrich (speech)
DEEPGRAM_API_KEY=

# ---- optional ----

# Where `ts.workflow.trace` writes trajectories. Unset means `trajectories/product-agent/`,
# which is a deliverable — live mode redirects this to a temp dir so a demo cannot pollute it.
# TS_TRACE_DIR=
