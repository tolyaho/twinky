.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
.env
*.sqlite3
.DS_Store
**/.DS_Store

# `evidence/` is COMMITTED on purpose, INCLUDING raw-results. These were ignored once as
# "regenerable noise" and that was wrong twice over: the product page reads them, so an archive
# without them offered a judge zero channels and a signals panel that never filled, and
# regenerating them needs `make replay` per fixture, which nothing tells a judge to run.
# 164 KB against a demo that works on first launch.

# large raw media stays out; captions/transcripts/chat are committed
evals/fixtures/**/audio.opus
evals/fixtures/**/raw/

# fixture-farm scaffolding output, not product
.farmlogs/

# capture salt - keeps pseudonyms stable locally, must never be distributed
.capture_salt

# never commit
telegram-export/
*.ogg

# Raw stdout/stderr from `run-night.sh`, one pair per iteration. Session output, and the loop
# writes them into the working tree — an unignored directory here fails preflight's
# "working tree committed" check the moment the loop is run again.
.nightlogs/
STOP

# Screen recordings of the running product. Hundreds of megabytes, regenerated by
# scripts/record_demo.py, and useless inside the archive. The SCRIPT is committed; the footage
# is not.
video/clips/
video/press/

# The submission archive, when it is kept beside the tree instead of in /tmp. `make archive`
# builds it from HEAD, so committing it would put a copy of the repository inside the repository
# — and the next archive would contain the last one.
/twinky.zip
