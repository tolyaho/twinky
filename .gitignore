.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
.env
*.sqlite3
.DS_Store
**/.DS_Store

# `evidence/` is COMMITTED on purpose, INCLUDING raw-results. These were ignored once as
# "regenerable noise" and that was wrong twice over: the product page reads them, so an archive
# without them offered a judge zero channels and a signals panel that never filled, and
# regenerating them needs `make replay` per fixture, which nothing tells a judge to run.
# 164 KB against a demo that works on first launch.

# large raw media stays out; captions/transcripts/chat are committed
evals/fixtures/**/audio.opus
evals/fixtures/**/raw/

# fixture-farm scaffolding output, not product
.farmlogs/

# capture salt - keeps pseudonyms stable locally, must never be distributed
.capture_salt

# never commit
telegram-export/
*.ogg

# Raw stdout/stderr from an unattended build loop, one pair per iteration. Session output, which
# belongs nowhere near a public repository. The loop that wrote these is gone; the rule stays,
# because the next one will write them again.
.nightlogs/
STOP

# Screen recordings and stills of the running product. Hundreds of megabytes, regenerated by
# scripts/record_demo.py and scripts/press_shots.py. The SCRIPTS are committed; the footage
# is not.
media/

# A zip of the tree, when it is kept beside the tree instead of in /tmp. `make archive` builds it
# from HEAD, so committing it would put a copy of the repository inside the repository — and the
# next archive would contain the last one.
/twinky.zip

# Personal Claude Code permissions, not team configuration.
.claude/settings.local.json
