.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
.env
*.sqlite3
.DS_Store
**/.DS_Store

# generated by `make replay` / `make eval` - reproduced from the cache, never committed
evidence/

# large raw media stays out; captions/transcripts/chat are committed
evals/fixtures/**/audio.opus
evals/fixtures/**/raw/

# capture salt - keeps pseudonyms stable locally, must never be distributed
.capture_salt

# never commit
telegram-export/
*.ogg
